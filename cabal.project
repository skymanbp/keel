-- The keel workspace: four capability packages plus the umbrella.
-- Dependency direction is strictly keel-dyn -> {keel-onnx, keel-linalg}
-- -> keel; keel-abi's library stands alone on base (keel-dyn appears
-- only in its test suites). The umbrella is the only package that will
-- ever depend on dataframe-core (Hackage), and only for the explicit
-- frame<->buffer copy bridge.
packages:
    packages/keel-dyn
    packages/keel-abi
    packages/keel-linalg
    packages/keel-onnx
    packages/keel

-- Reproducible dependency resolution, and a guard against Hackage CDN
-- serving a stale incremental index (seen on CI: an index frozen at
-- 2025-09 made dataframe-core an "unknown package"). With a pinned
-- index-state, a stale mirror fails loudly instead.
index-state: 2026-08-17T22:49:30Z
